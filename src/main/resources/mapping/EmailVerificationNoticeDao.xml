<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aliyun.autowonder.email.EmailVerificationNoticeDao">

    <insert id="insertIfAbsent">
        INSERT IGNORE INTO platform_email_verification_notice (policy_version)
        VALUES (#{policyVersion})
    </insert>

    <update id="updateCounts">
        UPDATE platform_email_verification_notice
        SET recipient_count = #{recipientCount},
            failure_count = #{failureCount}
        WHERE policy_version = #{policyVersion}
    </update>
</mapper>
